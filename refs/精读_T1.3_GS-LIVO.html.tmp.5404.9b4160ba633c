        <tr><td>Playground01/02</td><td>室内</td><td>自录</td><td>MoCap</td></tr>
        <tr><td>Landmark01</td><td>室内</td><td>自录</td><td>MoCap</td></tr>
      </tbody>
    </table>

    <h3>8.3 参数配置</h3>
    <ul>
      <li><b>Indoor</b>：root voxel 0.03 m / 0.06 m，max subdivision 2 layers；</li>
      <li><b>Outdoor (UAV)</b>：root voxel 0.5 m / 1.0 m，max subdivision 2 layers；</li>
      <li><b>Sliding window size</b>：桌面 100,000 Gaussians，嵌入式 20,000；</li>
      <li>15,000 iterations (=10 × 1500 frames) for fair comparison。</li>
    </ul>
  </section>

